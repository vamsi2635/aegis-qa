{
  "name": "aegis-qa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI-ready Playwright and TypeScript quality engineering framework",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "aegis:discover": "node scripts/aegis-discover.mjs .",
    "aegis:validate-scenarios": "node scripts/aegis-validate-scenarios.mjs .",
    "aegis:plan-scenarios": "node scripts/aegis-plan-scenarios.mjs .",
    "aegis:generate-tests": "node scripts/aegis-generate-tests.mjs .",
    "aegis:release-readiness": "node scripts/aegis-release-readiness.mjs .",
    "aegis:import-results": "node scripts/aegis-import-playwright-results.mjs .",
    "aegis:discover-url": "node scripts/aegis-discover-url.mjs",
    "aegis:explore-app": "node scripts/aegis-explore-app.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.0.0",
    "eslint-plugin-playwright": "^2.2.0",
    "globals": "^15.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
