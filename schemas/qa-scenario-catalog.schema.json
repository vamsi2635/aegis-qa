{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-qa.local/schemas/qa-scenario-catalog.schema.json",
  "title": "Aegis QA Scenario Catalog",
  "description": "Traceable, risk-ranked test scenarios. Expected behavior must come from approved requirements, not invention.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requirements", "scenarios"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "source", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[A-Z0-9][A-Z0-9._-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "status": { "enum": ["approved", "needs-clarification", "assumption"] },
          "notes": { "type": "string" }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirementIds", "title", "role", "preconditions", "testData", "steps", "expectedResult", "priority", "risk", "layer", "automationStatus"],
        "properties": {
          "id": { "type": "string", "pattern": "^TC-[A-Z0-9][A-Z0-9._-]*$" },
          "requirementIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^REQ-[A-Z0-9][A-Z0-9._-]*$" } },
          "title": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "testData": { "type": "array", "items": { "type": "string" }, "description": "Use synthetic/non-sensitive data references only." },
          "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "expectedResult": { "type": "string", "minLength": 1 },
          "priority": { "enum": ["P0", "P1", "P2", "P3"] },
          "risk": { "enum": ["critical", "high", "medium", "low"] },
          "layer": { "enum": ["unit", "integration", "api", "ui", "e2e", "accessibility", "performance", "security", "manual"] },
          "automationStatus": { "enum": ["candidate", "automated", "manual", "blocked", "not-applicable"] },
          "executionStatus": { "enum": ["not-run", "passed", "failed", "blocked", "inconclusive"] },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    }
  }
}